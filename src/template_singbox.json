{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "remote-dns",
        "address": "https://1.1.1.1/dns-query",
        "address_resolver": "local-dns",
        "detour": "🎯 Умный Авто-выбор",
        "strategy": "prefer_ipv4"
      },
      {
        "tag": "remote-dns-fallback",
        "address": "https://8.8.8.8/dns-query",
        "address_resolver": "local-dns",
        "detour": "🎯 Умный Авто-выбор",
        "strategy": "prefer_ipv4"
      },
      {
        "tag": "local-dns",
        "address": "77.88.8.8",
        "detour": "direct",
        "strategy": "prefer_ipv4"
      },
      {
        "tag": "block-dns",
        "address": "rcode://success"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          ".ru",
          "yandex.ru",
          "ya.ru",
          "vk.com",
          "mail.ru",
          "gosuslugi.ru",
          "sberbank.ru",
          "tbank.ru",
          "ozon.ru",
          "wildberries.ru",
          "kinopoisk.ru",
          "avito.ru",
          "hh.ru"
        ],
        "server": "local-dns"
      }
    ],
    "final": "remote-dns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "sniff": true,
      "sniff_override_destination": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "type": "urltest",
      "tag": "🎯 Умный Авто-выбор",
      "outbounds": [],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "2m",
      "tolerance": 40
    },
    {
      "type": "urltest",
      "tag": "🚀 Быстрый Global (Авто)",
      "outbounds": [],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "2m",
      "tolerance": 40
    },
    {
      "type": "urltest",
      "tag": "⚡ Белые Списки РФ (Авто)",
      "outbounds": [],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "2m",
      "tolerance": 40
    },
    {
      "type": "selector",
      "tag": "🎯 Ручной выбор",
      "outbounds": [
        "🎯 Умный Авто-выбор",
        "🚀 Быстрый Global (Авто)",
        "⚡ Белые Списки РФ (Авто)",
        "direct"
      ],
      "default": "🎯 Умный Авто-выбор"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "outbound": "dns-out"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          ".ru",
          "yandex.ru",
          "ya.ru",
          "vk.com",
          "mail.ru",
          "gosuslugi.ru",
          "sberbank.ru",
          "tbank.ru",
          "ozon.ru",
          "wildberries.ru",
          "kinopoisk.ru",
          "avito.ru",
          "hh.ru"
        ],
        "outbound": "direct"
      }
    ],
    "final": "🎯 Ручной выбор"
  }
}
